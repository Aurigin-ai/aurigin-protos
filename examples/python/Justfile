# aurigin-protos Python example runner.
#
# Wraps the `uv run server|client|phone-call|phone-call-burst` invocations
# documented in examples/README.md so devs don't need to memorise the CLI
# flags. Deps resolve from public PyPI — no CodeArtifact auth required.
#
# ─── transport / TLS ────────────────────────────────────────────────────────
# Three modes; pick the recipe family that matches your server:
#
#   default recipes (TLS) — `just server` / `just client` / `just phone-call`
#                           Auto-pick up the committed self-signed certs in
#                           ../certs/. Use these when both sides are this
#                           repo's example server.
#
#   `mtls-*` recipes      — same as above + `MTLS=1` so the server requires
#                           a client cert. Use when validating mutual TLS.
#
#   `insecure-*` recipes  — TLS_CA=/dev/null prefixed. Use when hitting a
#                           plaintext gRPC server (a backend-app dev box, a
#                           dfs running locally without TLS, aurigin-router's
#                           simulator on plaintext, …). The default `client`
#                           / `phone-call` recipes will TLS-handshake-fail
#                           against such a server with a cryptic OpenSSL
#                           "WRONG_VERSION_NUMBER" error — reach for the
#                           insecure-* variant instead.
#
# Argument convention:
#   Only structural args (N concurrency, SCENARIO_ID) are positional.
#   Everything else — --target, --audio, --duration, --stagger-ms, --csv,
#   --chunk-ms — is a CLI flag passed through verbatim. The recipes accept
#   any trailing flags via `*FLAGS`, so you never have to remember a
#   positional ordering, and `--audio FILE` can't accidentally land in the
#   wrong slot.
#
# Discoverability:
#   To see the full flag surface accepted by any `*FLAGS` recipe, run
#   `just help ENTRY` (e.g. `just help phone-call-burst`). Or call the
#   entry-point directly with `--help`: `uv run phone-call-burst --help`.
#
# Cheat sheet:
#   just sync                          # uv sync (installs deps)
#   just server                        # scenario-driven simulator on :50051
#   just client                        # client → localhost:50051 (TLS)
#   just client --target 127.0.0.1:50051       # client → custom target
#   just client --csv /tmp/out.csv             # client + CSV export
#   just insecure-client                       # client → plaintext localhost
#   just phone-call                            # paced WAV streamer → localhost (TLS)
#   just phone-call --audio FILE --duration 30 # custom audio + duration
#   just insecure-phone-call                   # ↑ but plaintext
#   just scenarios                             # list available scenarios
#   just call ID                               # phone-call w/ scenario (10s default)
#   just call ID --duration 30                 # phone-call w/ scenario, custom duration
#   just phone-call-burst 5 ID                                   # 5 concurrent calls of `ID`
#   just phone-call-burst 5 ID --stagger-ms 500                  # + 500ms stagger
#   just insecure-phone-call-burst 5                             # 5 plaintext bursts
#   just insecure-phone-call-burst 10 --duration 30 --audio FILE # 10 × 30s of FILE
#   just scan-file --file long.wav                               # offline batch scan (8 slices, TLS)
#   just scan-file-extreme --file long.wav                       # extreme preset (90 × 40s slices)
#   just scan-file-bench-no-vad --file long.wav                  # extreme + VAD-off bench floor
#   just insecure-scan-file --file long.wav                      # scan-file → plaintext dfs
#   just fingerprint-client                                      # WavLM embedding client → localhost (TLS)
#   just insecure-fingerprint-client                             # ↑ but plaintext
#   just mtls-fingerprint-client                                 # ↑ with client cert
#   just mtls-server                           # server in mTLS mode
#   just mtls-call ID                          # phone-call in mTLS mode
#   just mtls-phone-call-burst 5 ID            # 5 concurrent mTLS calls
#   just mtls-scan-file --file long.wav        # offline scan under mTLS
#   just tls                                   # regenerate the committed self-signed certs
#   just smoke                                 # end-to-end pytest
#
# See examples/certs/README.md for the full trust model.

set shell := ["bash", "-cu"]
set dotenv-load := true

[private]
default:
    @just --list --unsorted

# ─── help ────────────────────────────────────────────────────────────────────

# Recipes that take *FLAGS forward every flag verbatim to one of the Python
# entry-points (`client`, `phone-call`, `phone-call-burst`). The canonical
# list of accepted flags + their defaults lives in each entry's argparse.
# This recipe surfaces that list without leaving `just`:
#   just help client                  # client.py flags
#   just help phone-call              # phone_call.py flags
#   just help phone-call-burst        # phone_call_burst.py flags
#   just help server                  # simulator flags
#
# Print the full CLI flag surface for ENTRY (client | phone-call | phone-call-burst | server).
[group('help')]
help ENTRY:
    @uv run {{ENTRY}} --help

# ─── setup ───────────────────────────────────────────────────────────────────

# uv sync — install aurigin-protos + grpcio from public PyPI.
[group('setup')]
sync:
    uv sync

# One-shot: sync deps + run smoke tests.
[group('setup')]
bootstrap:
    @just sync && just smoke

# Wipe .venv/ and pytest/python caches in this dir.
[group('setup')]
clean:
    rm -rf .venv .pytest_cache __pycache__ */__pycache__

# ─── run ─────────────────────────────────────────────────────────────────────

# The scenario-driven simulator lives in `examples/simulator/deepfake/`
# now. `just server` used to run it from here; run it from that
# directory instead:
#   cd ../simulator/deepfake && uv run deepfake-simulator-service
# or via docker-compose in that same directory. This recipe is kept
# only to redirect anyone who muscle-memory-typed `just server`.
[group('run')]
server:
    @echo "server extracted to examples/simulator/deepfake/. Run:"
    @echo "  cd ../simulator/deepfake && uv run deepfake-simulator-service"
    @exit 1

# Pass any client.py flag as a trailing argument:
#   just client                                          # default target
#   just client --target 127.0.0.1:50051                 # custom target
#   just client --audio-dir ../audio/fixtures --csv /tmp/out.csv
# Run `uv run client --help` for the full flag surface.
#
# Client → localhost:50051 (TLS); pass any client.py flag.
[group('run')]
client *FLAGS:
    uv run client {{FLAGS}}

# Picks first audio/*.wav by default, 10s @ localhost:50051 (TLS). Pass any
# phone_call.py flag as a trailing argument:
#   just phone-call                                      # defaults
#   just phone-call --target 127.0.0.1:50051             # custom target
#   just phone-call --audio ../audio/fixtures/test_call_silence.wav --duration 30
# Run `uv run phone-call --help` for the full flag surface.
#
# Phone-call sim → localhost:50051 (TLS); pass any phone_call.py flag.
[group('run')]
phone-call *FLAGS:
    uv run phone-call {{FLAGS}}

# Offline batch scan — split one file into N parallel slices, no real-time
# pacing. Companion to `client` / `phone-call` for maximum-throughput file
# analysis. Slices are 5-s aligned (kills tail-window artifacts) and share
# one warm TLS channel. Pass any scan_file.py flag as a trailing argument:
#   just scan-file --file ../audio/long.wav                    # defaults (8 slices)
#   just scan-file --file long.wav --concurrency 32            # tune parallelism
#   just scan-file --file long.wav --extreme                   # 90 slices × 40s (GPU-saturating)
#   just scan-file --file long.wav --extreme --vad-mode off    # per-session VAD off (bench floor)
#   just scan-file --file long.wav --extreme --csv /tmp/o.csv  # + CSV export
# Run `uv run scan-file --help` for the full flag surface, including
# `--vad-mode {auto,on,off}` and `--vad-threshold PCT` (both require
# aurigin-protos ≥ 0.4).
#
# Offline batch scan → localhost:50051 (TLS); pass any scan_file.py flag.
[group('run')]
scan-file *FLAGS:
    uv run scan-file {{FLAGS}}

# Convenience wrapper: `just scan-file --extreme {{FLAGS}}`. Preset for
# maximum-throughput scanning (concurrency=90, frame_seconds=40) — sized so
# every stream fills one BATCH_SIZE=8 batch on the server. Requires a long
# file (≥60min) and headroom on the target dfs. Every scan_file.py flag is
# still available as a trailing arg (they override the preset knobs).
#
# Extreme-mode offline scan (concurrency=90 × 40s frames); pass any scan_file.py flag.
[group('run')]
scan-file-extreme *FLAGS:
    uv run scan-file --extreme {{FLAGS}}

# Benchmark helper: extreme preset + per-session VAD forced off. Answers
# "what's the GPU-only inference floor on this hardware?" — bypasses the
# CPU-side VAD gate that otherwise throttles window delivery at high
# concurrency. Requires the server-side vad_mode support (dfs on
# aurigin-protos ≥ 0.4). Compare against `just scan-file-extreme` on the
# same file to measure VAD's actual contribution to wall time.
#
# Extreme scan with per-session VAD disabled (GPU-only inference floor bench).
[group('run')]
scan-file-bench-no-vad *FLAGS:
    uv run scan-file --extreme --vad-mode off {{FLAGS}}

# Fingerprint client — streams every audio/*.wav (or 5s silence fallback) to
# `Fingerprint.ExtractFingerprint` and prints per-window EmbeddingResult
# details (offset, duration, fingerprint_code, dim, hex-preview of the first
# 8 bytes of the embedding). Pair with the fingerprint simulator for local
# runs:
#   cd ../simulator/fingerprint && uv run fingerprint-simulator-service
# Pass any fingerprint_client.py flag as a trailing argument:
#   just fingerprint-client                                    # defaults
#   just fingerprint-client --target 127.0.0.1:50051           # custom target
#   just fingerprint-client --audio-dir ../audio/fixtures      # custom dir
#
# Fingerprint client → localhost:50051 (TLS); pass any fingerprint_client.py flag.
[group('run')]
fingerprint-client *FLAGS:
    uv run fingerprint-client {{FLAGS}}

# ─── scenarios ──────────────────────────────────────────────────────────────

# Uses the same loader the simulator uses, so the list always matches
# what it accepts via the x-scenario-id metadata header. Imports the
# loader from the extracted simulator package via a PYTHONPATH shim.
#
# List loadable scenarios as `<id>  <description>`.
[group('scenarios')]
scenarios:
    @PYTHONPATH="../simulator/deepfake/src:$PYTHONPATH" uv run python -c "from deepfake_simulator_service.sim import load_scenarios; ss = load_scenarios('../scenarios'); [print(f'{s.id:38s}  {s.description}') for s in sorted(ss.values(), key=lambda s: s.id)]"

# Defaults to a 10-second call so most curves fire ≥1 analysis even on short
# scenarios. Pass any phone_call.py flag as a trailing argument:
#   just call fake_detected_rising_curve                 # default 10s
#   just call fake_detected_rising_curve --duration 30   # custom duration
#   just call fake_detected_rising_curve --audio ../audio/fixtures/test_call_silence.wav
#
# Phone-call against the local server, requesting a specific scenario.
[group('scenarios')]
call SCENARIO_ID *FLAGS:
    uv run phone-call --scenario-id {{SCENARIO_ID}} {{FLAGS}}

# Open N concurrent calls of the same scenario. With no --stagger-ms (default
# 0) every call fires at the same instant — the canonical thundering-herd
# test. `--stagger-ms 500` spreads start times: call-02 starts 500ms after
# call-01, call-03 1s after, and so on.
#   just phone-call-burst 5 fake_detected_rising_curve
#   just phone-call-burst 5 fake_detected_rising_curve --stagger-ms 500
#   just phone-call-burst 5 fake_detected_rising_curve --stagger-ms 500 --duration 30
#
# Backed by `phone_call_burst.py` — see that module's docstring for the
# multi-call architecture rationale (one channel, N concurrent bidi
# streams, graceful shutdown across all).
#
# N concurrent phone-calls against one scenario; pass any phone_call_burst.py flag.
[group('scenarios')]
phone-call-burst N SCENARIO_ID *FLAGS:
    uv run phone-call-burst --concurrency {{N}} --scenario-id {{SCENARIO_ID}} {{FLAGS}}

# ─── mtls ───────────────────────────────────────────────────────────────────

# These are just `MTLS=1` shortcuts on top of the recipes above. Functionally
# identical to prefixing `MTLS=1` yourself; recipes exist so the path is
# discoverable in `just --list` and aliases stay in sync if the underlying
# recipe signature changes.

# Simulator now lives in `examples/simulator/deepfake/` — set MTLS=1 in
# that directory instead:
#   cd ../simulator/deepfake && MTLS=1 uv run deepfake-simulator-service
[group('mtls')]
mtls-server:
    @echo "server extracted to examples/simulator/deepfake/. Run:"
    @echo "  cd ../simulator/deepfake && MTLS=1 uv run deepfake-simulator-service"
    @exit 1

# Same as `just call`, but presents the example client cert.
[group('mtls')]
mtls-call SCENARIO_ID *FLAGS:
    MTLS=1 just call {{SCENARIO_ID}} {{FLAGS}}

# Same as `just phone-call-burst`, but every concurrent stream is mTLS.
[group('mtls')]
mtls-phone-call-burst N SCENARIO_ID *FLAGS:
    MTLS=1 just phone-call-burst {{N}} {{SCENARIO_ID}} {{FLAGS}}

# Same as `just scan-file`, but every one of the N concurrent slice
# streams presents the example client cert. Use when the dfs is
# configured to require mTLS (aurigin.ai staging/prod, or any deployment
# with GRPC_CLIENT_AUTH=required).
#
# Offline batch scan → localhost:50051 (mTLS); pass any scan_file.py flag.
[group('mtls')]
mtls-scan-file *FLAGS:
    MTLS=1 just scan-file {{FLAGS}}

# Same as `just fingerprint-client`, but presents the example client cert.
[group('mtls')]
mtls-fingerprint-client *FLAGS:
    MTLS=1 just fingerprint-client {{FLAGS}}

# ─── insecure (plaintext) ────────────────────────────────────────────────────

# Use these when the gRPC server you're hitting does NOT speak TLS — e.g. a
# backend-app dev box, a deepfake-service running locally without certs,
# aurigin-router's plaintext simulator, or any external service that hasn't
# wired up the example certs. The default TLS recipes will fail handshake
# against such servers with a cryptic OpenSSL "WRONG_VERSION_NUMBER" error.
#
# Implementation: TLS_CA=/dev/null. tls.py treats a missing CA file as
# "insecure mode" and skips ssl_channel_credentials, falling back to
# grpc.insecure_channel.

# Defaults to localhost:50051; override with `--target HOST:PORT`. Pass any
# client.py flag as a trailing argument.
#
# Client → plaintext localhost:50051; pass any client.py flag.
[group('insecure')]
insecure-client *FLAGS:
    TLS_CA=/dev/null uv run client {{FLAGS}}

# Defaults to localhost:50051; override with `--target HOST:PORT`. Pass any
# phone_call.py flag as a trailing argument.
#
# Phone-call → plaintext localhost:50051; pass any phone_call.py flag.
[group('insecure')]
insecure-phone-call *FLAGS:
    TLS_CA=/dev/null uv run phone-call {{FLAGS}}

# Only useful if the plaintext server honors x-scenario-id metadata
# (e.g. aurigin-router's simulator). Real backends ignore it.
#
# Phone-call against a plaintext server, requesting a specific scenario.
[group('insecure')]
insecure-call SCENARIO_ID *FLAGS:
    TLS_CA=/dev/null uv run phone-call --scenario-id {{SCENARIO_ID}} {{FLAGS}}

# The recommended way to load-test a real backend (which is typically
# plaintext on internal networks). Only N is positional; everything else is
# a trailing CLI flag so the recipe never silently consumes `--audio`/etc.:
#   just insecure-phone-call-burst 10                                      # 10 × default duration
#   just insecure-phone-call-burst 10 --duration 30                        # 10 × 30s
#   just insecure-phone-call-burst 10 --duration 30 --stagger-ms 500       # + stagger
#   just insecure-phone-call-burst 10 --audio ../audio/fixtures/test_call_silence.wav
#   just insecure-phone-call-burst 10 --target dfs.internal:50051 --csv /tmp/out.csv
#
# N concurrent plaintext calls; pass any phone_call_burst.py flag.
[group('insecure')]
insecure-phone-call-burst N *FLAGS:
    TLS_CA=/dev/null uv run phone-call-burst --concurrency {{N}} {{FLAGS}}

# Plaintext variant of `just scan-file`. Use against a dfs / backend that
# is not running TLS (local dev, aurigin-router's plaintext simulator,
# internal test box). Pass any scan_file.py flag as a trailing argument.
#
# Offline batch scan → plaintext localhost:50051; pass any scan_file.py flag.
[group('insecure')]
insecure-scan-file *FLAGS:
    TLS_CA=/dev/null uv run scan-file {{FLAGS}}

# Plaintext variant of `just fingerprint-client`. Use against a fingerprint
# service / simulator that isn't running TLS (local dev without certs,
# `docker compose up` in `../simulator/fingerprint/` which is insecure by
# default). Pass any fingerprint_client.py flag as a trailing argument.
#
# Fingerprint client → plaintext localhost:50051; pass any fingerprint_client.py flag.
[group('insecure')]
insecure-fingerprint-client *FLAGS:
    TLS_CA=/dev/null uv run fingerprint-client {{FLAGS}}

# ─── tls ────────────────────────────────────────────────────────────────────

# DO NOT USE THESE KEYS IN PRODUCTION — they're checked into the public repo.
# Server cert SANs cover localhost, 127.0.0.1, ::1; both certs valid for 100
# years. The server + clients auto-detect ../certs/server.{crt,key} for TLS;
# MTLS=1 additionally activates ../certs/client.{crt,key} on both sides.
#
# Regenerate the committed self-signed example certs (server + client).
[group('tls')]
tls:
    @mkdir -p ../certs
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
        -keyout ../certs/server.key -out ../certs/server.crt -days 36500 \
        -subj "/CN=aurigin-protos-example/O=Example only — DO NOT USE IN PRODUCTION" \
        -addext "subjectAltName=DNS:localhost,IP:127.0.0.1,IP:::1"
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
        -keyout ../certs/client.key -out ../certs/client.crt -days 36500 \
        -subj "/CN=aurigin-protos-example-client/O=Example only — DO NOT USE IN PRODUCTION"
    @echo "→ ../certs/server.{crt,key} + ../certs/client.{crt,key} regenerated."
    @echo "  TLS picks up automatically; mTLS picks up when you set MTLS=1."

# Generate a proper CA-based mTLS bundle: 1 root CA, 1 server cert, N
# client certs (all EC P-256, signed by the CA). Different shape from
# `just tls` (self-signed simplified model) — this matches what real
# deepfake deployments expect: TLS_CLIENT_CA on the server + N distinct
# client certs each chaining to it.
#
# Env overrides (pass as VAR=VALUE before `just`):
#   OUTDIR        default examples/certs/mtls
#   CLIENT_COUNT  default 3
#   SERVER_SANS   default "DNS:localhost,IP:127.0.0.1,IP:::1"
#   DAYS          default 365
#
# Examples:
#   just mtls-bundle                                                # local defaults
#   SERVER_SANS="IP:54.228.43.76,DNS:localhost" just mtls-bundle    # T4 remote testing
#   CLIENT_COUNT=5 just mtls-bundle                                 # 5 clients instead of 3
#
# Wiring is printed after generation. Deploy server files to the deepfake
# host, keep client-N files on the caller side and set MTLS=1.
[group('tls')]
mtls-bundle:
    ../../scripts/gen-mtls-bundle.sh

# CLIENT-SIDE: generate a private key + CSR for a new client identity.
# The .key stays on this machine; the .csr goes to the CA operator.
# When they return the signed .crt, drop it next to the .key.
#
# Env overrides:
#   REUSE_KEY=<path>   Reuse an existing private key instead of minting a
#                      new one — writes only the .csr, leaves the .key
#                      untouched. Use for "rotate the cert but keep the
#                      key" (HSM-backed key, key pinning downstream,
#                      fast recovery from cert expiry). Prefer NOT to
#                      use for regular renewals — rotating the key each
#                      time is the safer default.
#
# Usage:
#   just mtls-client-csr CN                                   # fresh key
#   just mtls-client-csr CN /tmp/out                          # fresh key, custom outdir
#   REUSE_KEY=/tmp/out/CN.key just mtls-client-csr CN /tmp/out # reuse existing key
#
# Example — a new orchestrator identity (fresh key):
#   just mtls-client-csr orchestrator-prod-01
#   # → orchestrator-prod-01.key (secret, stays here)
#   # → orchestrator-prod-01.csr (send to CA)
#
# Example — rotate cert without touching the key:
#   REUSE_KEY=../secure/pki/wit-client.key \
#       just mtls-client-csr wit-client ../secure/pki
#   # → wit-client.csr (new CSR, bound to the existing key)
[group('tls')]
mtls-client-csr CN *OUTDIR:
    ../../scripts/gen-client-csr.sh {{CN}} {{OUTDIR}}

# CA-OPERATOR: sign a client-provided CSR against our CA. Server needs
# no changes — CA trust is already in TLS_CLIENT_CA, new client is
# accepted immediately. Give the .crt back to the requester.
#
# Env overrides:
#   CA_CRT (default ../certs/mtls/ca.crt), CA_KEY, DAYS (default 365)
#
# Usage:
#   just mtls-sign-csr /tmp/incoming/foo.csr             # signed cert next to CSR
#   just mtls-sign-csr /tmp/incoming/foo.csr /tmp/out    # signed cert in /tmp/out
[group('tls')]
mtls-sign-csr CSR *OUTDIR:
    ../../scripts/sign-client-csr.sh {{CSR}} {{OUTDIR}}

# Create a root CA — the trust anchor of an mTLS setup. Run this once
# per trust domain (one for your PKI, one per customer that brings their
# own, etc.). Not the same as `just mtls-bundle` — that composes CA +
# server + N clients in one shot. Use this when you want just the CA.
#
# Env overrides: DAYS (default 365), ORG (default Example)
#
# Usage:
#   just mtls-ca my-company-root                 # writes to cwd
#   just mtls-ca my-company-root /secure/pki     # writes to /secure/pki
#   DAYS=3650 just mtls-ca my-company-root       # 10-year root
[group('tls')]
mtls-ca NAME *OUTDIR:
    ../../scripts/gen-mtls-ca.sh {{NAME}} {{OUTDIR}}

# Mint an intermediate CA — a subordinate CA signed by an existing (root
# or higher-level) CA. Use for delegated / time-boxed trust: mint a
# short-lived intermediate under your long-lived root, ship it to a
# customer for a trial window, and let it self-expire.
#
# The intermediate has basicConstraints=CA:TRUE,pathlen:0 so it CAN sign
# leaf certs (client / server) but CANNOT sign further intermediates —
# bounds the delegation depth.
#
# Required env: CA_CRT, CA_KEY (paths to the SIGNING parent CA — usually
# your root CA from `just mtls-ca`).
# Env overrides: DAYS (default 30 — intentionally short since intermediates
# are typically used to time-box trust), ORG (default Example).
#
# Usage:
#   CA_CRT=/secure/pki/my-root.crt CA_KEY=/secure/pki/my-root.key DAYS=30 \
#       just mtls-intermediate customer-a-trial-ca /secure/trials
#
# After minting, sign leaf certs against the intermediate (not the root):
#   CA_CRT=/secure/trials/customer-a-trial-ca.crt \
#   CA_KEY=/secure/trials/customer-a-trial-ca.key DAYS=365 \
#       just mtls-sign-csr /tmp/incoming/customer-a.csr
#
# Ship (leaf.crt + intermediate.crt) as a concatenated chain to the caller.
[group('tls')]
mtls-intermediate NAME *OUTDIR:
    ../../scripts/gen-mtls-intermediate.sh {{NAME}} {{OUTDIR}}

# Mint a server cert against an existing CA. Use to rotate the server
# identity without regenerating the CA, or to issue a server cert in a
# separate step from CA creation.
#
# Named `mtls-server-cert` (not `mtls-server`) because the latter already
# exists in the run-with-MTLS-mode recipe group above — this one is a
# cert-generation operation, not a server-runtime shortcut.
#
# SANs argument: comma-separated "IP:<addr>" or "DNS:<name>" entries.
# **NO port numbers in IP entries** — SANs identify the host, not the
# port. Example: "IP:192.0.2.10,DNS:svc.example.internal,DNS:localhost"
#
# Required env: CA_CRT, CA_KEY (paths to the signing CA).
# Env overrides: DAYS (default 365), ORG (default Example)
#
# Usage:
#   CA_CRT=./ca.crt CA_KEY=./ca.key \
#       just mtls-server-cert myserver "IP:192.0.2.10,DNS:localhost,IP:127.0.0.1"
[group('tls')]
mtls-server-cert NAME SANS *OUTDIR:
    ../../scripts/gen-mtls-server.sh {{NAME}} {{SANS}} {{OUTDIR}}

# Mint a client cert against an existing CA — LOCAL shortcut where the
# CA operator also generates the client's key. Appropriate for dev or
# internal services you own. For remote customer clients, use the CSR
# round-trip (mtls-client-csr on their side + mtls-sign-csr on yours)
# so their private key never leaves their machine.
#
# Required env: CA_CRT, CA_KEY (paths to the signing CA).
# Env overrides: DAYS (default 365), ORG (default Example)
#
# Usage:
#   CA_CRT=./ca.crt CA_KEY=./ca.key just mtls-client-cert my-service
#   CA_CRT=./ca.crt CA_KEY=./ca.key just mtls-client-cert my-service /tmp/certs
[group('tls')]
mtls-client-cert NAME *OUTDIR:
    ../../scripts/gen-mtls-client.sh {{NAME}} {{OUTDIR}}

# ─── test ────────────────────────────────────────────────────────────────────

# End-to-end smoke tests (spawns server + client, asserts output).
[group('test')]
smoke:
    uv run --extra test pytest tests/ -v
